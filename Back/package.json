{
  "name": "parkit-back",
  "version": "1.0.0",
  "description": "API REST de Parkit - plataforma que conecta conductores con propietarios de estacionamientos",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env.local src/index.js",
    "dev": "node --watch-path=src --env-file=.env.local src/index.js",
    "db:crear": "node --env-file=.env.local src/db/local/crear-base.js && npm run db:migrate",
    "db:migrate": "node --env-file=.env.local src/db/migrate.js",
    "db:restaurar": "node --env-file=.env.local src/db/local/restaurar.js && npm run db:migrate",
    "db:crear-admin": "node --env-file=.env.local src/db/crear-admin.js",
    "db:mover-reserva": "node --env-file=.env.local src/db/mover-reserva.js",
    "db:calificaciones-demo": "node --env-file=.env.local src/db/calificaciones-demo.js",
    "test": "node --test --env-file=.env.local \"pruebas/*.test.mjs\""
  },
  "keywords": [
    "parkit",
    "estacionamientos",
    "reservas",
    "api",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "pg": "^8.23.0"
  }
}
