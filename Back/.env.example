# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# --- Base de datos ----------------------------------------------------------
# Neon:  postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local: postgresql://postgres:password@localhost:5432/parkit_dev
DATABASE_URL=postgresql://usuario:password@localhost:5432/parkit_dev
# Con Neon (o cualquier proveedor administrado) poner true: usa SSL sin validar
# el certificado del proveedor. En una base local, false.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Autenticacion ----------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# --- Geocodificacion (direccion -> latitud/longitud) ------------------------
# Usa Nominatim de OpenStreetMap (gratis, max. 1 request por segundo).
# Por defecto esta activa (las pruebas la apagan solas). Para apagarla:
# GEOCODING_ENABLED=false
# Nominatim pide un User-Agent que identifique a la app (idealmente con un email de contacto).
GEOCODING_USER_AGENT=Parkit/1.0 (proyecto PID 2026)
