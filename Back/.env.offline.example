# Modo offline: copiar a Back/.env.offline y completar (ver docs/offline.md).
# Lo usan `npm run dev:offline` y los scripts `npm run offline:*`. El .env normal
# (el de desarrollo online) no se toca.

OFFLINE=true
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# --- Base local (Postgres instalado en esta maquina, sin Docker) -------------
# Con Homebrew el usuario es el de macOS y no tiene contrasena:
#   postgresql://<tu-usuario>@localhost:5432/parkit_local
# Los scripts se niegan a correr si esto no apunta a localhost.
DATABASE_URL=postgresql://usuario@localhost:5432/parkit_local
DATABASE_SSL=false

# --- Autenticacion -----------------------------------------------------------
# Cualquier valor largo. Tambien firma las subidas de fotos locales.
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria

# --- Solo para preparar (una vez, con internet) -------------------------------
# offline:copiar: cadena de conexion de Neon, proyecto ParkIt, branch production
# (Neon -> Connect -> desmarcar "Connection pooling"). pg_dump solo lee.
PRODUCCION_DATABASE_URL=
# offline:fotos: el cloud name de Cloudinary de donde se bajan las fotos.
CLOUDINARY_CLOUD_NAME=

# Opcional: donde quedan fotos, mapa y la copia de la base (por defecto Back/datos-locales).
# DATOS_LOCALES_DIR=
