# Copiar a Back/.env.local y completar (ver docs/local.md). Todo corre en esta
# maquina: no hace falta internet.

# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# --- Base de datos (Postgres local) -----------------------------------------
# Con Homebrew el usuario es el de macOS y no tiene contrasena.
DATABASE_URL=postgresql://usuario@localhost:5432/parkit_local
DATABASE_POOL_MAX=10

# --- Autenticacion ----------------------------------------------------------
# Cualquier valor largo. Tambien firma las subidas de fotos.
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Opcional: donde quedan fotos, mapa y la copia de la base (por defecto Back/datos-locales).
# DATOS_LOCALES_DIR=
