{
  "name": "parkit-back",
  "version": "1.0.0",
  "description": "API REST de Parkit - plataforma que conecta conductores con propietarios de estacionamientos",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "db:migrate": "node --env-file=.env src/db/migrate.js",
    "db:migrate:prod": "node src/db/migrate.js",
    "test": "node --test --env-file=.env \"pruebas/*.test.mjs\"",
    "test:ci": "node --test \"pruebas/*.test.mjs\""
  },
  "keywords": [
    "parkit",
    "estacionamientos",
    "reservas",
    "api",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "pg": "^8.23.0"
  }
}
